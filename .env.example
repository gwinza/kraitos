# Kraitos environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Application
KRAITOS_ENV=development
KRAITOS_LOG_LEVEL=INFO

# MetaTrader 5 connection
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Safety switches — live order placement requires ALL of these (default: disabled)
LIVE_TRADING=false
ENABLE_LIVE_TRADING=false
LIVE_TRADING_ENABLED=false

# Broker integration (mt5 | deriv | iqoption)
BROKER_NAME=mt5
BROKER_ACCOUNT_ID=
BROKER_SANDBOX=true

# Broker credentials (example — replace with your provider)
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_BASE_URL=

# Data feed
DATA_PROVIDER=
DATA_API_KEY=

# Database (optional)
DATABASE_URL=

# Dashboard (optional)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

# Kraitos Sports — live odds (https://the-odds-api.com)
THE_ODDS_API_KEY=
SPORTS_USE_LIVE_ODDS=true
